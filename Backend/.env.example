# Environment Configuration
# Copy this file to .env and update with your values

# Node Environment
NODE_ENV=development

# Server Port
PORT=3000

# API URL (for Swagger documentation)
API_URL=http://localhost:3000/api

# MongoDB Connection
# Development: mongodb://localhost:27017/hms
# Production: mongodb://username:password@host:port/database?authSource=admin
MONGODB_URI=mongodb://localhost:27017/hms

# JWT Configuration
# IMPORTANT: Change this to a strong random string in production (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Frontend URL (for CORS)
# Development: http://localhost:4200
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:4200

# Trust Proxy (set to true if behind reverse proxy)
TRUST_PROXY=false

# Email Service (Optional)
EMAIL_ENABLED=false
EMAIL_FROM=noreply@hms.com
EMAIL_FROM_NAME=HMS System
# SMTP Configuration (if using Nodemailer)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Swagger Documentation
# Set to true to enable Swagger in production
ENABLE_SWAGGER=false
