{
  "name": "hms-backend",
  "version": "1.0.0",
  "description": "Hospital Management System Backend",
  "main": "server.js",
  "scripts": {
    "start": "node scripts/start-production.js",
    "dev": "nodemon server.js",
    "start:direct": "node server.js",
    "test": "echo \"Tests not yet implemented\" && exit 0",
    "lint": "eslint . --ext .js --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .js --fix --ignore-path .gitignore",
    "backup": "node scripts/backup.js",
    "backup:compress": "node scripts/backup.js --compress",
    "restore": "node scripts/restore.js",
    "optimize-db": "node scripts/optimize-db.js",
    "health-check": "node -e \"require('http').get('http://localhost:3000/api/health', (r) => {let d='';r.on('data',c=>d+=c);r.on('end',()=>{console.log(d);process.exit(r.statusCode===200?0:1)})})\"",
    "verify": "node scripts/verify-production.js"
  },
  "keywords": ["hms", "hospital", "management"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-mongo-sanitize": "^2.2.0",
    "xss-clean": "^0.1.3",
    "hpp": "^0.2.3",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
